Package: mrpheus
Title: Raw Physiological Signal Analysis for Biological Rhythms Research
Version: 0.1.1
Authors@R: c(
    person("Lucas", "França",
           email = "lucas.franca@northumbria.ac.uk",
           role = c("aut", "cre")),
    person("Mario", "Leocadio-Miguel",
